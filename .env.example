APP_ENV=development
APP_NAME=ProofAI
DEBUG=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Model Providers Configuration (mock | qwen | deepseek | custom)
LLM_PROVIDER=mock
CODE_GEN_PROVIDER=mock
EMBEDDING_PROVIDER=mock

LLM_MODEL=qwen3-4b-instruct
CODE_MODEL=deepseek-coder-v2-lite
EMBEDDING_MODEL=qwen3-embedding-0.6b

DATA_DIR=./datasets
DOCUMENT_DIR=./documents
STORAGE_DIR=./storage

EXECUTION_TIMEOUT=10
SANDBOX_ENABLED=false
MAX_UPLOAD_SIZE_MB=50
